<Window x:Class="WpfTaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="مدير المهام" Height="650" Width="980" WindowStartupLocation="CenterScreen" Background="#FFF7F7F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="تطبيق إدارة المهام" FontSize="30" FontWeight="Bold" Foreground="#2B2D42" />

        <Border Grid.Row="1" Margin="0,18,0,18" Padding="14" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#FFE3E3E3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,12,0" Height="40" VerticalContentAlignment="Center" Padding="12,0"
                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="15" ToolTip="عنوان المهمة" />
                <TextBox Grid.Column="1" Margin="0,0,12,0" Height="40" VerticalContentAlignment="Center" Padding="12,0"
                         Text="{Binding NewTaskNotes, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="15" ToolTip="تفاصيل إضافية" />
                <Button Grid.Column="2" Padding="20,10" Content="إضافة مهمة" Command="{Binding AddTaskCommand}" 
                        Background="#2B2D42" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#FFE3E3E3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                          Margin="14" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="المهمة" Width="240" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="التفاصيل" Width="300" DisplayMemberBinding="{Binding Notes}" />
                            <GridViewColumn Header="تاريخ الإضافة" Width="170" DisplayMemberBinding="{Binding CreatedAt}" />
                            <GridViewColumn Header="الحالة" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsCompleted, StringFormat=مكتملة: {0}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14">
                    <Button Content="تبديل حالة المحددة" Command="{Binding ToggleTaskCommand}" Margin="0,0,10,0" Padding="16,8" Background="#EDF2F4" BorderThickness="0" />
                    <Button Content="حذف المحددة" Command="{Binding DeleteTaskCommand}" Margin="0,0,10,0" Padding="16,8" Background="#EF233C" Foreground="White" BorderThickness="0" />
                    <Button Content="حذف المكتملة" Command="{Binding ClearCompletedCommand}" Padding="16,8" Background="#8D99AE" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Foreground="#4A4E69" FontSize="14">
                <Run Text="إجمالي: " /><Run Text="{Binding TotalCount}" />
                <Run Text="  | مكتملة: " /><Run Text="{Binding CompletedCount}" />
                <Run Text="  | متبقية: " /><Run Text="{Binding PendingCount}" />
            </TextBlock>

            <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshCommand}" Padding="14,8" Background="#2B2D42" Foreground="White" BorderThickness="0" />
        </Grid>
    </Grid>
</Window>
