<Window x:Class="WpfTaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تتبع كلفة التنقل" Height="760" Width="1100" WindowStartupLocation="CenterScreen" Background="#FFF7F7F7"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="تطبيق احتساب كلفة التنقل" FontSize="30" FontWeight="Bold" Foreground="#2B2D42" />

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="14" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#FFE3E3E3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,10,0" Height="38" VerticalContentAlignment="Center" Padding="12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" ToolTip="ابحث بالاسم" />

                <TextBox Grid.Column="1" Margin="0,0,10,0" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                         Text="{Binding FullDayCost, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                         ToolTip="كلفة اليوم الكامل" />

                <TextBox Grid.Column="2" Margin="0,0,10,0" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                         Text="{Binding HalfDayCost, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                         ToolTip="كلفة نصف اليوم" />

                <Button Grid.Column="3" Content="حفظ الإعدادات" Command="{Binding SaveSettingsCommand}" Padding="16,8"
                        Background="#2B2D42" Foreground="White" BorderThickness="0" Margin="0,0,10,0" />

                <Button Grid.Column="4" Content="مسح البحث" Command="{Binding ClearSearchCommand}" Padding="16,8" Background="#EDF2F4" BorderThickness="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,12" Padding="14" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#FFE3E3E3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,10,0" Height="40" VerticalContentAlignment="Center" Padding="12,0"
                         Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" ToolTip="اسم الموظف" />

                <DatePicker Grid.Column="1" Margin="0,0,10,0" SelectedDate="{Binding NewTravelDate, Mode=TwoWay}" Height="40" />

                <CheckBox Grid.Column="2" Content="نصف يوم" IsChecked="{Binding IsNewRecordHalfDay}" VerticalAlignment="Center" FontSize="14" Margin="10,0" />

                <TextBox Grid.Column="3" Margin="0,0,10,0" Height="40" VerticalContentAlignment="Center" Padding="12,0"
                         Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" ToolTip="ملاحظات" />

                <Button Grid.Column="4" Padding="20,10" Content="إضافة" Command="{Binding AddRecordCommand}"
                        Background="#118AB2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#FFE3E3E3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding FilteredRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          Margin="14" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="الاسم" Width="200" DisplayMemberBinding="{Binding EmployeeName}" />
                            <GridViewColumn Header="التاريخ" Width="130" DisplayMemberBinding="{Binding TravelDate, StringFormat=d}" />
                            <GridViewColumn Header="نوع اليوم" Width="100" DisplayMemberBinding="{Binding DayTypeLabel}" />
                            <GridViewColumn Header="الكلفة" Width="100" DisplayMemberBinding="{Binding Cost, StringFormat=F2}" />
                            <GridViewColumn Header="الملاحظات" Width="260" DisplayMemberBinding="{Binding Notes}" />
                            <GridViewColumn Header="أضيف في" Width="170" DisplayMemberBinding="{Binding CreatedAt, StringFormat=g}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="14">
                    <Button Content="حذف المحدد" Command="{Binding DeleteRecordCommand}" Margin="0,0,10,0" Padding="16,8" Background="#EF233C" Foreground="White" BorderThickness="0" />
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Padding="16,8" Background="#8D99AE" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12" Background="#F0F4F8" CornerRadius="8">
            <WrapPanel>
                <TextBlock Foreground="#2B2D42" FontSize="14" Margin="0,0,20,0">
                    <Run Text="عدد السجلات: " /><Run Text="{Binding TotalCount}" />
                </TextBlock>
                <TextBlock Foreground="#2B2D42" FontSize="14" Margin="0,0,20,0">
                    <Run Text="مجموع اليوم الكامل: " /><Run Text="{Binding FullDayTotal, StringFormat=F2}" /><Run Text=" درهم" />
                </TextBlock>
                <TextBlock Foreground="#2B2D42" FontSize="14" Margin="0,0,20,0">
                    <Run Text="مجموع نصف اليوم: " /><Run Text="{Binding HalfDayTotal, StringFormat=F2}" /><Run Text=" درهم" />
                </TextBlock>
                <TextBlock Foreground="#0B6E4F" FontSize="15" FontWeight="Bold">
                    <Run Text="الإجمالي: " /><Run Text="{Binding TotalCost, StringFormat=F2}" /><Run Text=" درهم" />
                </TextBlock>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
