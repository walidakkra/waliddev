<Window x:Class="WpfTaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Travel Cost Calculator"
        Height="780"
        Width="1200"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Travel Cost Calculator" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Manage employee travel records and expenses" FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="18" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Employee Name" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Destination" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="From" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="To" Margin="0,0,8,6" FontWeight="SemiBold"/>

                <TextBox x:Name="EmployeeNameTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,10,12" Padding="10,8"/>
                <TextBox x:Name="DestinationTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,12" Padding="10,8"/>
                <TextBox x:Name="FromTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,10,12" Padding="10,8"/>
                <TextBox x:Name="ToTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,12" Padding="10,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Distance (km)" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Duration (hours)" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Travel Type" Margin="0,0,8,6" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Cost per Travel (MAD)" Margin="0,0,8,6" FontWeight="SemiBold"/>

                <TextBox x:Name="DistanceTextBox" Grid.Row="3" Grid.Column="0" Margin="0,0,10,12" Padding="10,8"/>
                <TextBox x:Name="DurationTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,10,12" Padding="10,8"/>
                <ComboBox x:Name="TravelTypeComboBox" Grid.Row="3" Grid.Column="2" Margin="0,0,10,12" Padding="10,6" SelectionChanged="TravelTypeComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="Half Day" IsSelected="True"/>
                    <ComboBoxItem Content="Full Day"/>
                </ComboBox>
                <TextBox x:Name="CostTextBox" Grid.Row="3" Grid.Column="3" Margin="0,0,0,12" Padding="10,8" IsReadOnly="True" Background="#F9FAFB"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="16" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Add Travel" Width="120" Height="36" Margin="0,0,10,0" Click="AddTravelButton_OnClick" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                    <Button Content="Delete Selected Travel" Width="170" Height="36" Margin="0,0,10,0" Click="DeleteTravelButton_OnClick" Background="#DC2626" Foreground="White" BorderThickness="0"/>
                    <Button Content="Clear Fields" Width="120" Height="36" Margin="0,0,10,0" Click="ClearFieldsButton_OnClick" Background="#6B7280" Foreground="White" BorderThickness="0"/>
                    <Button Content="Calculate Total" Width="130" Height="36" Click="CalculateTotalButton_OnClick" Background="#059669" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <DataGrid x:Name="TravelsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}" Width="*"/>
                        <DataGridTextColumn Header="From" Binding="{Binding FromLocation}" Width="*"/>
                        <DataGridTextColumn Header="To" Binding="{Binding ToLocation}" Width="*"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                        <DataGridTextColumn Header="Distance" Binding="{Binding Distance, StringFormat={}{0:N2} km}" Width="130"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat={}{0:N2} h}" Width="120"/>
                        <DataGridTextColumn Header="Travel Type" Binding="{Binding TravelType}" Width="120"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat={}{0:N2} MAD}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="14" Background="#EEF2FF" CornerRadius="12" BorderBrush="#C7D2FE" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total cost for selected employee:" FontWeight="SemiBold" Foreground="#1F2937"/>
                <TextBlock x:Name="EmployeeTotalTextBlock" Text="0.00 MAD" Margin="6,0,24,0" FontWeight="Bold" Foreground="#1D4ED8"/>
                <TextBlock Text="Total cost of all travels:" FontWeight="SemiBold" Foreground="#1F2937"/>
                <TextBlock x:Name="GrandTotalTextBlock" Text="0.00 MAD" Margin="6,0,0,0" FontWeight="Bold" Foreground="#047857"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
